        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Burn rate by alert window",
      "description": "Dashed lines = page thresholds: 14.4x (1h & 5m) and 6x (6h & 30m). Both windows must exceed a threshold for the alert to fire.",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "max(slo:sli_error:ratio_rate5m{sloth_id=\"$slo\"}) / (1 - max(slo:objective:ratio{sloth_id=\"$slo\"}))",
          "legendFormat": "5m",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "max(slo:sli_error:ratio_rate1h{sloth_id=\"$slo\"}) / (1 - max(slo:objective:ratio{sloth_id=\"$slo\"}))",
          "legendFormat": "1h",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "max(slo:sli_error:ratio_rate6h{sloth_id=\"$slo\"}) / (1 - max(slo:objective:ratio{sloth_id=\"$slo\"}))",
          "legendFormat": "6h",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "axisSoftMax": 16,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
