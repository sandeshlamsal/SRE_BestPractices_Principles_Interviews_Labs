    {
      "id": 14,
      "type": "stat",
      "title": "Budget policy status",
      "description": "Text form of the budget policy tier, so status is never shown by colour alone.",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "x": 19,
        "y": 9,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "max(slo:period_error_budget_remaining:ratio{sloth_id=\"$slo\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 1000000000.0,
                "result": {
                  "text": "OK: ship freely",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.25,
                "to": 0.5,
                "result": {
                  "text": "CAUTION: rollback plans",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.25,
                "result": {
                  "text": "AT RISK: reliability first",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": -1000000000.0,
                "to": 0,
                "result": {
                  "text": "EXHAUSTED: feature freeze",
