          },
          "expr": "max(slo:current_burn_rate:ratio{sloth_id=\"$slo\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 2,
