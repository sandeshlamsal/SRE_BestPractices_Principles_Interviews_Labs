      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "expr": "1 - max(slo:sli_error:ratio_rate1d{sloth_id=\"$slo\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
